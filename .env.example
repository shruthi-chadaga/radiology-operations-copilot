# Application
APP_ENV=local
APP_NAME=Radiology Operations Copilot
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database — local demo values only
POSTGRES_DB=radiology_ops
POSTGRES_USER=radiology_ops
POSTGRES_PASSWORD=replace_with_a_unique_local_database_password
DATABASE_URL=postgresql+psycopg://radiology_ops:replace_with_a_unique_local_database_password@postgres:5432/radiology_ops

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Authentication — replace before sharing the environment
JWT_SECRET=replace_with_a_long_local_secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SCHEDULER_DEMO_PASSWORD=replace_with_a_unique_local_password
PACS_ADMIN_DEMO_PASSWORD=replace_with_a_unique_local_password
OPERATIONS_MANAGER_DEMO_PASSWORD=replace_with_a_unique_local_password
AUDITOR_DEMO_PASSWORD=replace_with_a_unique_local_password
SYSTEM_ADMIN_DEMO_PASSWORD=replace_with_a_unique_local_password

# AI provider — mock mode is the safe offline default
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MOCK_MODE=true
ENABLE_AI=true

# Orthanc source
ORTHANC_SOURCE_URL=http://orthanc-source:8042
ORTHANC_SOURCE_USERNAME=source_admin
ORTHANC_SOURCE_PASSWORD=replace_with_a_unique_local_source_orthanc_password
ORTHANC_SOURCE_AET=SOURCE_PACS

# Orthanc destination
ORTHANC_DESTINATION_URL=http://orthanc-destination:8042
ORTHANC_DESTINATION_USERNAME=destination_admin
ORTHANC_DESTINATION_PASSWORD=replace_with_a_unique_local_destination_orthanc_password
ORTHANC_DESTINATION_AET=DEST_PACS
ORTHANC_DESTINATION_DICOM_HOST=orthanc-destination
ORTHANC_DESTINATION_DICOM_PORT=4242

# MailHog — never configure an external SMTP host in the local MVP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@radiology-ops.local

# Automation safety
ENABLE_AUTO_RETRY=false
MAX_AUTO_RETRIES=1
LOW_CONFIDENCE_THRESHOLD=0.80
